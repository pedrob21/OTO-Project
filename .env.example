# copie este arquivo substituindo o nome para .env e preencha. O .env fica fora do Git.
# escreva os valores sem aspas.

# dados para o banco
POSTGRES_DB=oto
POSTGRES_USER=oto
POSTGRES_PASSWORD=troque-esta-senha

# porta que o PostgreSQL vai subir na sua máquina (mude se já tiver outro Postgres na 5432)
DB_PORT=5432

# porta da aplicação na sua máquina quando ela roda pelo compose
APP_PORT=8080

# secret que assina os tokens de login -> você consegue gerar
# um com: openssl rand -hex 32  (ou digite uma sequência longa de letras e números).
JWT_SEGREDO=

# primeiro administrador do sistema, criado na subida se o e-mail ainda não existir.
# senha com pelo menos 8 caracteres. Depois de entrar, troque a senha pelo sistema.
ADMIN_NOME=Administrador OTO
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=

# endereço do front que estará autorizado a chamar a API (opcional; o padrão libera localhost)
# CORS_ORIGENS=
